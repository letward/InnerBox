# Normalise line endings: keep the repository LF, let Git convert on checkout
# on Windows. Godot and Python source are both happier with a stable LF.
* text=auto eol=lf

*.gd       text eol=lf
*.tscn     text eol=lf
*.godot    text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.import   text eol=lf
*.svg      text eol=lf

*.png      binary
*.wav      binary
*.ico      binary
*.exe      binary
